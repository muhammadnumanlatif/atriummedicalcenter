---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Notice of Nondiscrimination | ATRIUM MEDICAL CENTER"
  description="Notice of Nondiscrimination for ATRIUM MEDICAL CENTER."
>
  <section class="page-header">
    <div class="container text-center">
      <h1>Notice of Nondiscrimination</h1>
      <p>ATRIUM MEDICAL CENTER • Stafford, TX</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container policy-content">
      <h2>Nondiscrimination Statement</h2>
      <p>Atrium Medical Center complies with applicable Federal civil rights laws and does not discriminate on the basis of race, color, national origin, age, disability, or sex. Atrium Medical Center does not exclude people or treat them differently because of race, color, national origin, age, disability, or sex.</p>
      
      <h2>Language & Auxiliary Aids</h2>
      <p>Atrium Medical Center provides free auxiliary aids and services to people with disabilities to communicate effectively, such as qualified sign language interpreters and written information in multiple formats.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background: var(--color-surface-dark); color: var(--color-on-dark); padding: 4rem 0 3rem; text-align: center; border-bottom: 3px solid var(--color-primary); }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .policy-content { max-width: 800px; margin: 0 auto; line-height: 1.7; }
  .policy-content h2 { font-size: 1.5rem; color: var(--color-ink); margin: 2rem 0 0.75rem; border-bottom: 2px solid var(--color-primary); padding-bottom: 0.4rem; }
  .policy-content p { color: var(--color-body); margin-bottom: 1.25rem; }
</style>
