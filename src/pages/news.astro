---
import BaseLayout from '../layouts/BaseLayout.astro';

const news = [
  {
    date: "January 20, 2026",
    title: "Atrium Medical Center Expands High-Acuity ICU & Ventilator Weaning Capacity",
    summary: "Atrium Medical Center announces expanded 20-bed ICU monitoring technology to support complex post-surgical and acute respiratory patients across Greater Houston."
  },
  {
    date: "December 15, 2025",
    title: "Achieving 91.8% Patient Satisfaction & Care Quality Standards",
    summary: "Patient and family surveys rate Atrium Medical Center care quality at 91.8%, with over 90% highly recommending the facility for long-term acute care."
  },
  {
    date: "November 02, 2025",
    title: "Advanced Wound Care & Hyperbaric Oxygen Therapy Milestones",
    summary: "Our specialized burn and wound care team highlights key healing benchmarks achieved through integrated hyperbaric oxygen therapy (HBO)."
  }
];
---

<BaseLayout
  title="News & Stories | ATRIUM MEDICAL CENTER Stafford, TX"
  description="Latest announcements, clinical updates, and patient stories from ATRIUM MEDICAL CENTER in Stafford, TX."
>
  <section class="page-header">
    <div class="container text-center">
      <h1>News & Hospital Stories</h1>
      <p>Latest Announcements & Healthcare Insights from Atrium Medical Center</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="news-list">
        {news.map(item => (
          <article class="news-card">
            <span class="news-date">{item.date}</span>
            <h2>{item.title}</h2>
            <p>{item.summary}</p>
            <a href="/contact" class="read-more">Read Full Story →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-primary);
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 850px;
    margin: 0 auto;
  }
  .news-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    padding: 2.25rem;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
  }
  .news-date {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .news-card h2 {
    font-size: 1.5rem;
    color: var(--color-ink);
    margin: 0.5rem 0 0.85rem;
  }
  .news-card p {
    color: var(--color-mute);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .read-more {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
