---
import BaseLayout from '../layouts/BaseLayout.astro';

const news = [
  {
    date: "January 20, 2026",
    title: "Understanding Long-Term Acute Care Hospitals (LTACH): A Comprehensive Clinical Guide",
    summary: "In-depth 2,400+ word clinical guide explaining LTACH care models, 24/7 ICU monitoring, ventilator liberation protocols, bedside dialysis, and complex wound care in Stafford, TX.",
    url: "/news/understanding-ltach-guide",
    featured: true
  },
  {
    date: "January 10, 2026",
    title: "Atrium Medical Center Expands High-Acuity ICU & Ventilator Weaning Capacity",
    summary: "Atrium Medical Center announces expanded 20-bed ICU monitoring technology to support complex post-surgical and acute respiratory patients across Greater Houston.",
    url: "/services/pulmonary-management-and-respiratory-therapy",
    featured: false
  },
  {
    date: "December 15, 2025",
    title: "Achieving 91.8% Patient Satisfaction & Care Quality Standards",
    summary: "Patient and family surveys rate Atrium Medical Center care quality at 91.8%, with over 90% highly recommending the facility for long-term acute care.",
    url: "/about",
    featured: false
  },
  {
    date: "November 02, 2025",
    title: "Advanced Wound Care & Hyperbaric Oxygen Therapy Milestones",
    summary: "Our specialized burn and wound care team highlights key healing benchmarks achieved through integrated hyperbaric oxygen therapy (HBO).",
    url: "/services/all-stage-burn-and-wound-care",
    featured: false
  }
];
---

<BaseLayout
  title="News & Stories | ATRIUM MEDICAL CENTER Stafford, TX"
  description="Latest clinical guides, announcements, medical updates, and patient stories from ATRIUM MEDICAL CENTER in Stafford, TX."
>
  <section class="page-header">
    <div class="container text-center">
      <h1>News, Articles & Hospital Stories</h1>
      <p>In-Depth Clinical Guides & Healthcare Insights from Atrium Medical Center</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="news-list">
        {news.map(item => (
          <article class={`news-card ${item.featured ? 'featured' : ''}`}>
            {item.featured && <span class="featured-badge">Featured Clinical Guide</span>}
            <span class="news-date">{item.date}</span>
            <h2><a href={item.url}>{item.title}</a></h2>
            <p>{item.summary}</p>
            <a href={item.url} class="read-more">Read Full Story →</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-primary);
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 850px;
    margin: 0 auto;
  }
  .news-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    padding: 2.25rem;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    position: relative;
  }
  .news-card.featured {
    border: 2px solid var(--color-primary);
    background: var(--color-bg-alt);
  }
  .featured-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--color-primary);
    color: var(--color-on-dark);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.75rem;
    border-radius: 50px;
    text-transform: uppercase;
  }
  .news-date {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .news-card h2 {
    font-size: 1.5rem;
    color: var(--color-ink);
    margin: 0.5rem 0 0.85rem;
  }
  .news-card h2 a {
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }
  .news-card h2 a:hover {
    color: var(--color-primary);
  }
  .news-card p {
    color: var(--color-mute);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .read-more {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
