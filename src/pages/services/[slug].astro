---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'pulmonary-management-and-respiratory-therapy' },
      props: {
        title: 'Pulmonary Management & Respiratory Therapy',
        desc: 'ATRIUM MEDICAL CENTER offers state-of-the-art pulmonary management services for patients in need of respiratory and rehabilitative care. We provide personalized, compassionate attention to each patient to promote a healthy recovery.',
        details: [
          '24 Hours a day, 7 days a week Respiratory Therapy coverage',
          'Intensive Care Unit (ICU) & Medical-Surgical unit care',
          'Treatments for COPD, ARDS, Pneumonia, Asthma, and Sleep Apnea',
          'Non-invasive mechanical ventilation (CPAP / BiPAP) & Ventilator Weaning',
          'Arterial Blood Gas (ABG) sampling & Pulse Oximetry monitoring',
          'Chest Percussion Therapy & Airway Management'
        ]
      }
    },
    {
      params: { slug: '24-hour-nursing-care' },
      props: {
        title: '24 Hour Nursing Care',
        desc: 'Our 24-hour nursing care team provides round-the-clock intensive medical monitoring, medication administration, and compassionate bedside care for complex patients.',
        details: [
          'Continuous 24/7 registered nurse (RN) staffing',
          'High nurse-to-patient ratios tailored for complex acuity',
          'Medication administration, IV therapy, and wound monitoring',
          'Patient advocacy, comfort prioritization, and family support'
        ]
      }
    },
    {
      params: { slug: 'behavioral-health' },
      props: {
        title: 'Behavioral Health',
        desc: 'Address mental health concerns with comprehensive behavioral health services designed for emotional and psychological support during physical recovery.',
        details: [
          'Comprehensive psychiatric assessment & treatment plans',
          'Emotional support for chronic illness & trauma recovery',
          'Multidisciplinary team of psychiatrists & mental health professionals'
        ]
      }
    },
    {
      params: { slug: '24-hour-physician-coverage' },
      props: {
        title: '24-Hour Physician Coverage',
        desc: 'Benefit from continuous, expert medical care with our dedicated 24-hour physician coverage for complete patient safety.',
        details: [
          'On-site board-certified physicians available 24/7/365',
          'Rapid response for medical emergencies & ICU patient changes',
          'Collaboration across 90+ multi-specialty clinical doctors'
        ]
      }
    },
    {
      params: { slug: 'physical-and-occupational-therapy' },
      props: {
        title: 'Physical and Occupational Therapy',
        desc: 'Improve mobility and daily living skills with personalized physical and occupational therapy tailored to each patient recovery path.',
        details: [
          'Customized mobility & endurance rehabilitation plans',
          'Activities of Daily Living (ADL) retraining',
          'Neuromuscular re-education & strength training'
        ]
      }
    },
    {
      params: { slug: 'speech-therapy' },
      props: {
        title: 'Speech Therapy',
        desc: 'Improve communication and swallowing skills with speech therapy tailored to address individual cognitive and neurological challenges.',
        details: [
          'Dysphagia (swallowing disorder) evaluations & therapy',
          'Cognitive-linguistic rehabilitation following stroke or brain injury',
          'Tracheostomy communication device training'
        ]
      }
    },
    {
      params: { slug: 'dietitian-or-nutritional-care' },
      props: {
        title: 'Dietitian / Nutritional Care',
        desc: 'Optimize your health with expert dietitian and clinical nutritional care services designed to support healing and systemic wellness.',
        details: [
          'Clinical nutritional assessment by licensed registered dietitians',
          'Total Parenteral Nutrition (TPN) & Enteral feeding management',
          'Diabetic, renal, and wound-healing therapeutic diets'
        ]
      }
    },
    {
      params: { slug: 'invasive-procedures' },
      props: {
        title: 'Invasive Procedures',
        desc: 'Receive expert bedside care and precise treatment for invasive medical procedures designed to address complex conditions.',
        details: [
          'Bedside thoracentesis, paracentesis, and lumbar punctures',
          'Central line placement & chest tube monitoring',
          'Strict sterile technique & ultrasound guidance'
        ]
      }
    },
    {
      params: { slug: 'all-stage-burn-and-wound-care' },
      props: {
        title: 'All-Stage Burn & Wound Care',
        desc: 'Our wound care team offers expert treatment for chronic wounds, surgical breakdown, and burn injuries focusing on rapid healing and infection prevention.',
        details: [
          'Advanced wound debridement & negative pressure therapy (Wound VAC)',
          'All-stage burn management & specialized skin grafting care',
          'Hyperbaric Oxygen Therapy (HBO) integration for non-healing tissue'
        ]
      }
    },
    {
      params: { slug: 'in-house-or-outpatient-dialysis' },
      props: {
        title: 'In-House / Outpatient Dialysis',
        desc: 'In-house hemodialysis services designed for maximum patient convenience, personalized care, and optimal clinical outcomes.',
        details: [
          'Bedside acute hemodialysis for ICU & room-bound patients',
          'Outpatient dialysis coordination & vascular access care',
          'Nephrologist-supervised renal replacement therapy'
        ]
      }
    },
    {
      params: { slug: 'infectious-disease' },
      props: {
        title: 'Infectious Disease Management',
        desc: 'Atrium Medical Center prioritizes infection control through strict isolation protocols, advanced hygiene, and proactive disease management.',
        details: [
          'Board-certified Infectious Disease physician oversight',
          'Treatment of MDROs (MRSA, VRE, C. diff, Pseudomonas)',
          'Negative-pressure isolation rooms & hospital infection surveillance'
        ]
      }
    },
    {
      params: { slug: 'long-term-intravenous-antibiotic-therapy' },
      props: {
        title: 'Long-Term Intravenous Antibiotic Therapy',
        desc: 'We offer long-term IV antibiotic therapy with expert monitoring, vascular catheter management, and personalized laboratory tracking.',
        details: [
          'Multi-week IV antibiotic regimens for severe infections',
          'Therapeutic drug monitoring & peak/trough blood draws',
          'PICC line maintenance & outpatient infusion transition'
        ]
      }
    },
    {
      params: { slug: 'medically-complex' },
      props: {
        title: 'Medically Complex Care',
        desc: 'Specialized interdisciplinary care for patients suffering from multiple organ system failure, chronic illness, or surgical complications.',
        details: [
          'Comprehensive multi-organ management (Cardiac, Renal, Pulmonary)',
          'Frequent physician rounds & daily care team huddles',
          'Family conferences & long-term goal setting'
        ]
      }
    },
    {
      params: { slug: 'picc-or-central-lines-insertion-and-care' },
      props: {
        title: 'PICC / Central Lines Insertion and Care',
        desc: 'Specializing in vascular access placement and line management ensuring safe, comfortable, long-term intravenous therapy.',
        details: [
          'Vascular access team for PICC & Midline insertions',
          'Daily dressing changes & catheter patency flushes',
          'Central venous catheter infection prevention bundles'
        ]
      }
    },
    {
      params: { slug: 'hyperbaric-oxygen-or-hbo' },
      props: {
        title: 'Hyperbaric Oxygen / HBO Therapy',
        desc: 'Hyperbaric Oxygen Therapy (HBO) speeds tissue healing and improves outcomes for diabetic ulcers, osteomyelitis, and chronic wounds.',
        details: [
          '100% pure oxygen hyperbaric chamber sessions',
          'Enhanced angiogenesis & white blood cell bactericidal activity',
          'Certified hyperbaric technicians & wound care specialists'
        ]
      }
    },
    {
      params: { slug: 'acute-geriatric-psychiatry-unit' },
      props: {
        title: 'Acute Geriatric Psychiatry Unit',
        desc: 'Specialized, compassionate inpatient psychiatric ward catering to elderly patients experiencing acute mental health crises or behavioral changes.',
        details: [
          'Secure, specialized 24/7 geriatric psychiatric unit',
          'Assessment of dementia-related behaviors, depression, & psychosis',
          'Geriatric psychiatrists, psych nurses, & social workers'
        ]
      }
    }
  ];
}

const { title, desc, details } = Astro.props;
---

<BaseLayout
  title={`${title} | ATRIUM MEDICAL CENTER (LTACH) Stafford, TX`}
  description={desc}
>
  <section class="page-header">
    <div class="container text-center">
      <span class="sub-heading">Specialized LTACH Program</span>
      <h1>{title}</h1>
      <p>ATRIUM MEDICAL CENTER • Stafford, Texas</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container grid-2">
      <div class="service-content">
        <h2>Program Overview</h2>
        <p class="lead-text">{desc}</p>
        
        <h3>Key Clinical Capabilities & Treatments</h3>
        <ul class="capabilities-list">
          {details.map(item => (
            <li>✓ {item}</li>
          ))}
        </ul>

        <div class="referral-box">
          <h3>Physician Referrals & Patient Admissions</h3>
          <p>
            Our clinical liaisons and admissions staff are available 24/7 to process patient transfers, insurance pre-authorizations, and physician inquiries.
          </p>
          <div class="referral-actions">
            <a href="tel:2812078200" class="btn-primary">Call Admissions: 281-207-8200</a>
            <a href="/contact" class="btn-outline">Send Patient Referral →</a>
          </div>
        </div>
      </div>

      <div class="side-card">
        <h3>Contact Atrium Medical Center</h3>
        <div class="info-group">
          <strong>📍 Address:</strong>
          <p>11929 West Airport Blvd.<br/>Stafford, TX 77477</p>
        </div>
        <div class="info-group">
          <strong>📞 Telephone:</strong>
          <p><a href="tel:2812078200">281-207-8200</a></p>
        </div>
        <div class="info-group">
          <strong>📠 Fax:</strong>
          <p>281-207-8388</p>
        </div>
        <div class="info-group">
          <strong>✉️ Email:</strong>
          <p><a href="mailto:admin@atriummedicalcenter.com">admin@atriummedicalcenter.com</a></p>
        </div>
        <a href="/services" class="btn-gold full-width">← View All 16 Services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-primary);
  }
  .sub-heading {
    color: #35c49b;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  .page-header h1 {
    font-size: 2.4rem;
    margin: 0.5rem 0;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 3.5rem;
  }

  .service-content h2 {
    font-size: 2rem;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }
  .lead-text {
    font-size: 1.15rem;
    color: var(--color-body);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .service-content h3 {
    font-size: 1.4rem;
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }

  .capabilities-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }
  .capabilities-list li {
    font-size: 1.02rem;
    background-color: var(--color-surface-soft);
    padding: 0.85rem 1.25rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-weight: 500;
  }

  .referral-box {
    background-color: #f2f7f4;
    border-left: 4px solid var(--color-primary);
    padding: 2rem;
    border-radius: var(--border-radius);
  }
  .referral-box h3 {
    margin-bottom: 0.5rem;
  }
  .referral-box p {
    margin-bottom: 1.5rem;
  }
  .referral-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .side-card {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 2rem;
    border-radius: var(--border-radius);
    height: fit-content;
  }
  .side-card h3 {
    color: var(--color-on-dark);
    border-bottom: 1px solid var(--color-hairline-strong);
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .info-group {
    margin-bottom: 1.25rem;
  }
  .info-group strong {
    color: var(--color-accent-gold);
    display: block;
    font-size: 0.85rem;
  }
  .info-group a {
    color: var(--color-on-dark);
    text-decoration: underline;
  }
  .full-width {
    width: 100%;
    margin-top: 1rem;
  }

  @media (max-width: 992px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
