---
import BaseLayout from '../../layouts/BaseLayout.astro';

const services = [
  {
    title: "Pulmonary Management & Respiratory Therapy",
    slug: "pulmonary-management-and-respiratory-therapy",
    category: "Pulmonary & Respiratory",
    desc: "24/7 comprehensive treatment for COPD, ARDS, pneumonia, asthma, and ventilator weaning care.",
    icon: "🫁"
  },
  {
    title: "24 Hour Nursing Care",
    slug: "24-hour-nursing-care",
    category: "Specialized Care",
    desc: "Compassionate, round-the-clock nursing care tailored for continuous medical monitoring and support.",
    icon: "🩺"
  },
  {
    title: "Behavioral Health",
    slug: "behavioral-health",
    category: "Psychiatry & Behavioral",
    desc: "Comprehensive mental health and emotional support programs for complex patient populations.",
    icon: "🧠"
  },
  {
    title: "24-Hour Physician Coverage",
    slug: "24-hour-physician-coverage",
    category: "Specialized Care",
    desc: "Continuous multi-specialty physician oversight to guarantee patient safety and care quality.",
    icon: "👨‍⚕️"
  },
  {
    title: "Physical and Occupational Therapy",
    slug: "physical-and-occupational-therapy",
    category: "Rehabilitation",
    desc: "Targeted physical & occupational therapy to rebuild strength, endurance, and independent living skills.",
    icon: "🏃‍♂️"
  },
  {
    title: "Speech Therapy",
    slug: "speech-therapy",
    category: "Rehabilitation",
    desc: "Expert cognitive-communication and swallowing therapy tailored to stroke and trauma recovery.",
    icon: "🗣️"
  },
  {
    title: "Dietitian / Nutritional Care",
    slug: "dietitian-or-nutritional-care",
    category: "Specialized Care",
    desc: "Personalized nutritional assessment, TPN, and clinical dietary plans supporting tissue healing.",
    icon: "🥗"
  },
  {
    title: "Invasive Procedures",
    slug: "invasive-procedures",
    category: "Specialized Care",
    desc: "Bedside invasive medical procedures and interventions managed by certified clinical specialists.",
    icon: "🔬"
  },
  {
    title: "All-Stage Burn & Wound Care",
    slug: "all-stage-burn-and-wound-care",
    category: "Wound & HBO",
    desc: "Advanced treatment for non-healing chronic wounds, surgical breakdown, and severe burn injuries.",
    icon: "🩹"
  },
  {
    title: "In-House / Outpatient Dialysis",
    slug: "in-house-or-outpatient-dialysis",
    category: "Renal & Dialysis",
    desc: "Bedside hemodialysis and acute renal replacement therapy designed for high-acuity patients.",
    icon: "🩸"
  },
  {
    title: "Infectious Disease",
    slug: "infectious-disease",
    category: "Infectious Disease",
    desc: "Strict infection control, isolation management, and multi-drug resistant organism therapy.",
    icon: "🧫"
  },
  {
    title: "Long-Term Intravenous Antibiotic Therapy",
    slug: "long-term-intravenous-antibiotic-therapy",
    category: "Infectious Disease",
    desc: "Monitored long-term IV antibiotic administration with catheter maintenance and blood monitoring.",
    icon: "💉"
  },
  {
    title: "Medically Complex Care",
    slug: "medically-complex",
    category: "Specialized Care",
    desc: "Multidisciplinary management for patients suffering from multi-organ failure and chronic illnesses.",
    icon: "🏥"
  },
  {
    title: "PICC / Central Lines Insertion and Care",
    slug: "picc-or-central-lines-insertion-and-care",
    category: "Specialized Care",
    desc: "Expert insertion, dressing changes, and line maintenance for PICC lines and central catheters.",
    icon: "🩺"
  },
  {
    title: "Hyperbaric Oxygen / HBO",
    slug: "hyperbaric-oxygen-or-hbo",
    category: "Wound & HBO",
    desc: "Hyperbaric oxygen therapy chamber treatments accelerating tissue oxygenation and wound healing.",
    icon: "⚡"
  },
  {
    title: "Acute Geriatric Psychiatry Unit",
    slug: "acute-geriatric-psychiatry-unit",
    category: "Psychiatry & Behavioral",
    desc: "Specialized inpatient unit catering specifically to elderly patients experiencing acute mental illness.",
    icon: "👵"
  }
];
---

<BaseLayout
  title="Our Medical Services | ATRIUM MEDICAL CENTER (LTACH) Stafford, TX"
  description="Explore all 16 specialized Long-Term Acute Care Hospital services at ATRIUM MEDICAL CENTER in Stafford, TX. From 24/7 pulmonary care to dialysis and wound care."
>
  <section class="page-header">
    <div class="container text-center">
      <h1>Our Medical Services</h1>
      <p>Explore our 16 specialized long-term acute care hospital programs in Stafford, TX</p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="services-search-bar">
        <input type="text" id="service-search" placeholder="🔍 Search services (e.g. Pulmonary, Dialysis, Wound Care)..." />
      </div>

      <div class="services-grid" id="services-container">
        {services.map(service => (
          <div class="service-card" data-title={service.title.toLowerCase()} data-category={service.category}>
            <div class="card-header">
              <span class="service-icon">{service.icon}</span>
              <span class="category-badge">{service.category}</span>
            </div>
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
            <a href={`/services/${service.slug}`} class="service-btn">Read Service Details →</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-surface-dark);
    color: var(--color-on-dark);
    padding: 4rem 0 3rem;
    text-align: center;
    border-bottom: 3px solid var(--color-primary);
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: var(--color-on-dark-mute);
    font-size: 1.1rem;
  }

  .services-search-bar {
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .services-search-bar input {
    width: 100%;
    padding: 1rem 1.25rem;
    font-size: 1.05rem;
    border: 2px solid var(--color-hairline);
    border-radius: 50px;
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .services-search-bar input:focus {
    border-color: var(--color-primary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
  .service-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    padding: 1.75rem;
    border-radius: var(--border-radius);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--transition-fast);
  }
  .service-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    transform: translateY(-4px);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .service-icon {
    font-size: 2.2rem;
  }
  .category-badge {
    font-size: 0.75rem;
    background-color: var(--color-surface-soft);
    color: var(--color-primary);
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--color-hairline);
  }
  .service-card h3 {
    font-size: 1.25rem;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .service-card p {
    font-size: 0.92rem;
    color: var(--color-mute);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .service-btn {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.92rem;
  }
</style>

<script>
  const searchInput = document.getElementById('service-search') as HTMLInputElement;
  const cards = document.querySelectorAll('.service-card') as NodeListOf<HTMLElement>;

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      if (title.includes(query)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  });
</script>
